{"format":"recordly-project","version":1,"id":"p-coucou-setup","name":"Coucou — connect it to Claude Code","created":"2026-10-05T18:52:26.898Z","edited":"2026-10-05T19:00:27.309Z","duration":43,"folders":[],"recordingIds":["rec-coucou-setup"],"bg":"g-3","doc":{"clips":[{"id":"clip-muvlz54k-0","recId":"rec-coucou-setup","in":0,"out":43.016667,"speed":1,"muted":false,"screen":"dashboard","name":"Coucou — connect it to Claude Code"}],"zooms":[{"id":"zm-flow-0","start":0.99,"end":5.12,"amount":2,"mode":"manual","focus":{"x":50,"y":14.81}},{"id":"zm-flow-1","start":7.97,"end":11.32,"amount":2,"mode":"manual","focus":{"x":43.23,"y":8.8}},{"id":"zm-muvlz5hy-1-0","start":12.4,"end":15.03,"amount":1.4,"mode":"manual","focus":{"x":50.05,"y":10.28},"suggested":"12.4|24.3|1.4|auto|45|31"},{"id":"zm-flow-3","start":16.03,"end":18.34,"amount":1.5,"mode":"manual","focus":{"x":50.1,"y":40}},{"id":"zm-flow-4","start":19.34,"end":20.98,"amount":1.5,"mode":"manual","focus":{"x":50.1,"y":40}},{"id":"zm-muvlz5hy-1-1","start":21.98,"end":26.17,"amount":1.4,"mode":"manual","focus":{"x":50.1,"y":45.56},"suggested":"12.4|24.3|1.4|auto|45|31"},{"id":"zm-muvlz5hy-2-0","start":27.2,"end":29.54,"amount":1.5,"mode":"manual","focus":{"x":50.1,"y":54.35},"suggested":"27.2|32.8|1.5|auto|46|46"},{"id":"zm-muvlz5hy-2-1","start":30.54,"end":33.27,"amount":1.5,"mode":"manual","focus":{"x":50.1,"y":30.74},"suggested":"27.2|32.8|1.5|auto|46|46"},{"id":"zm-flow-8","start":34.27,"end":39.2,"amount":2,"mode":"manual","focus":{"x":50,"y":14.81}}],"captions":[{"id":"cap-0","start":1.815,"end":8.769,"text":"This is Coucou. It lives at the top of your screen and keeps an eye on your AI coding agent."},{"id":"cap-1","start":8.789,"end":13.307,"text":"Out of the box, it isn't connected to Claude Code yet."},{"id":"cap-2","start":13.327,"end":16.299,"text":"Open Settings,"},{"id":"cap-3","start":16.319,"end":19.601,"text":"and find Claude Code."},{"id":"cap-4","start":19.621,"end":22.245,"text":"Install the hooks."},{"id":"cap-5","start":22.265,"end":28.103,"text":"Coucou shows the exact change it makes, and backs up the old settings."},{"id":"cap-6","start":28.123,"end":30.805,"text":"Back up and write,"},{"id":"cap-7","start":30.825,"end":35.075,"text":"and that's it — Coucou is hooked in."},{"id":"cap-8","start":35.095,"end":42.967,"text":"Back in the island, it says connected. Your next Claude Code session shows up right here."}],"annotations":[],"audio":[],"keyframes":[],"aspect":"16:9","scene":{"bgType":"image","bg":"w-grain-8","bgOn":true,"blur":0,"shadow":60,"radius":7,"corners":null,"padding":40,"sides":{"t":68.26666666666667,"l":40,"r":40,"b":40},"crop":{"t":0,"r":0,"b":0,"l":0},"uploads":[],"videoUploads":[]},"cursor":{"show":true,"loop":false,"style":"tahoe","size":2.5,"click":"off","clickColor":"#3B63FB","clickSize":1,"clickOpacity":60,"clickDuration":420,"bounce":1,"bounceSpeed":180,"sway":0.6},"webcam":{"show":false,"width":19,"height":null,"position":"bl","custom":{"x":80,"y":75},"margin":25,"roundness":53,"shadow":36,"crop":{"x":0,"y":0,"w":100,"h":100},"mirror":true,"reactToZooms":true,"linked":null},"captionStyle":{"show":true,"animation":"fade","fontSize":32,"font":"Inter","bold":true,"italic":false,"underline":false,"uppercase":false,"color":"#FFFFFF","rows":2,"bottom":84.41,"maxWidth":82,"radius":10,"bgOpacity":78,"manualAdd":true},"motion":{"preset":"smooth","connect":true,"classic":false},"audioNormalizeAll":false,"voice":{"denoise":"balanced","level":true},"shortcuts":[],"shortcutStyle":{"show":true,"position":"bottom","size":28,"theme":"dark","labels":"pc"},"shortcutsImported":true}}