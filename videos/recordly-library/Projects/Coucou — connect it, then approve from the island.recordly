{"format":"recordly-project","version":1,"id":"p-coucou-approve","name":"Coucou — connect it, then approve from the island","created":"2026-10-06T21:16:41.674Z","edited":"2026-10-06T21:21:51.316Z","duration":47,"folders":[],"recordingIds":["rec-coucou-approve"],"bg":"g-3","doc":{"clips":[{"id":"clip-mux6iho6-0","recId":"rec-coucou-approve","in":0,"out":46.583333,"speed":1,"muted":false,"screen":"dashboard","name":"Coucou — connect it, then approve from the island"}],"zooms":[{"id":"zm-flow-2","start":9.44,"end":13.36,"amount":1.8,"mode":"manual","focus":{"x":40,"y":8.67}},{"id":"zm-flow-5","start":19.46,"end":23.64,"amount":1.4,"mode":"manual","focus":{"x":49.51,"y":54.33}},{"id":"zm-flow-9","start":33.5,"end":37.63,"amount":1.6,"mode":"manual","focus":{"x":44.62,"y":10.67}},{"id":"zm-mux6iikd-5","start":41.22,"end":41.87,"amount":1.3,"mode":"manual","focus":{"x":45.03,"y":7.44},"suggested":"39.07|41.87|2|auto|45|13"},{"id":"zm-flow-11","start":42.87,"end":46.41,"amount":1.6,"mode":"manual","focus":{"x":45.03,"y":7.44}}],"captions":[{"id":"cap-0","start":2.995,"end":10.236,"text":"This is Coucou. It sits at the top of your screen and keeps an eye on your Claude Code sessions."},{"id":"cap-1","start":10.256,"end":14.244,"text":"Out of the box, it isn't connected to Claude Code yet."},{"id":"cap-2","start":14.264,"end":17.342,"text":"Open Settings,"},{"id":"cap-3","start":17.362,"end":19.459,"text":"and install the hooks."},{"id":"cap-4","start":19.479,"end":24.796,"text":"Coucou shows the exact change it makes, and backs up your old settings."},{"id":"cap-5","start":24.816,"end":30.519,"text":"Back up and write, and that's it."},{"id":"cap-6","start":30.539,"end":33.912,"text":"The island says connected."},{"id":"cap-7","start":33.932,"end":39.193,"text":"Now, when Claude needs to run a command, the request shows up right here."},{"id":"cap-8","start":39.213,"end":46.533,"text":"Click Allow, and Claude carries on, without you switching to the terminal."}],"annotations":[],"audio":[],"keyframes":[],"aspect":"16:10","scene":{"bgType":"image","bg":"w-grain-8","bgOn":true,"blur":0,"shadow":60,"radius":7,"corners":null,"padding":40,"sides":{"t":68.26666666666667,"l":40,"r":40,"b":40},"crop":{"t":0,"r":0,"b":0,"l":0},"uploads":[],"videoUploads":[]},"cursor":{"show":true,"loop":false,"style":"tahoe","size":2.5,"click":"off","clickColor":"#3B63FB","clickSize":1,"clickOpacity":60,"clickDuration":420,"bounce":1,"bounceSpeed":180,"sway":0.6},"webcam":{"show":false,"width":19,"height":null,"position":"bl","custom":{"x":80,"y":75},"margin":25,"roundness":53,"shadow":36,"crop":{"x":0,"y":0,"w":100,"h":100},"mirror":true,"reactToZooms":true,"linked":null},"captionStyle":{"show":true,"animation":"fade","fontSize":32,"font":"Inter","bold":true,"italic":false,"underline":false,"uppercase":false,"color":"#FFFFFF","rows":2,"bottom":84.41,"maxWidth":82,"radius":10,"bgOpacity":78,"manualAdd":true},"motion":{"preset":"smooth","connect":true,"classic":false},"audioNormalizeAll":false,"voice":{"denoise":"balanced","level":true},"shortcuts":[],"shortcutStyle":{"show":true,"position":"bottom","size":28,"theme":"dark","labels":"pc"},"shortcutsImported":true}}