{"format":"recordly-project","version":1,"id":"p-umami-setup","name":"Umami — set up analytics for your website","created":"2026-10-03T10:48:14.379Z","edited":"2026-10-03T10:52:36.083Z","duration":40,"folders":[],"recordingIds":["rec-umami-setup"],"bg":"g-3","doc":{"clips":[{"id":"clip-mus9qpwk-0","recId":"rec-umami-setup","in":0,"out":40.416667,"speed":1,"muted":false,"screen":"dashboard","name":"Umami — set up analytics for your website"}],"zooms":[{"id":"zm-mus9qqcr-1-0","start":0.4,"end":6.88,"amount":1.8,"mode":"manual","focus":{"x":50,"y":34.33},"suggested":"0.4|8.93|1.8|auto|50|37"},{"id":"zm-flow-4","start":11.34,"end":16.76,"amount":1.6,"mode":"manual","focus":{"x":50,"y":49.94}},{"id":"zm-flow-9","start":22.8,"end":26.2,"amount":1.6,"mode":"manual","focus":{"x":58.33,"y":73.89}},{"id":"zm-mus9qqcr-4","start":27.2,"end":29.43,"amount":2,"mode":"manual","focus":{"x":83.13,"y":73.33},"suggested":"27.2|30.23|2|auto|83|74"},{"id":"zm-flow-12","start":33.98,"end":38.09,"amount":1.6,"mode":"manual","focus":{"x":42.64,"y":33.06}}],"captions":[{"id":"cap-0","start":0.594,"end":4.31,"text":"This is Umami. Sign in with your username,"},{"id":"cap-1","start":4.33,"end":6.298,"text":"and your password,"},{"id":"cap-2","start":6.318,"end":8.879,"text":"then click Login."},{"id":"cap-3","start":8.899,"end":11.23,"text":"Click Add website."},{"id":"cap-4","start":11.25,"end":16.118,"text":"Give it a name, and the domain your site lives on."},{"id":"cap-5","start":16.138,"end":18.731,"text":"Save it, and it's in your list."},{"id":"cap-6","start":18.751,"end":23.591,"text":"Open the website, then click Edit."},{"id":"cap-7","start":23.611,"end":27.454,"text":"This is your tracking code: one line of script."},{"id":"cap-8","start":27.474,"end":31.127,"text":"Copy it into the head of your pages."},{"id":"cap-9","start":31.147,"end":34.773,"text":"Now, when someone visits your site,"},{"id":"cap-10","start":34.793,"end":40.367,"text":"Umami counts the visit. No cookies needed."}],"annotations":[],"audio":[],"keyframes":[],"aspect":"16:10","scene":{"bgType":"image","bg":"w-grain-8","bgOn":true,"blur":0,"shadow":60,"radius":7,"corners":null,"padding":40,"sides":{"t":68.26666666666667,"l":40,"r":40,"b":40},"crop":{"t":0,"r":0,"b":0,"l":0},"uploads":[],"videoUploads":[]},"cursor":{"show":true,"loop":false,"style":"tahoe","size":2.5,"click":"off","clickColor":"#3B63FB","clickSize":1,"clickOpacity":60,"clickDuration":420,"bounce":1,"bounceSpeed":180,"sway":0.6},"webcam":{"show":false,"width":19,"height":null,"position":"bl","custom":{"x":80,"y":75},"margin":25,"roundness":53,"shadow":36,"crop":{"x":0,"y":0,"w":100,"h":100},"mirror":true,"reactToZooms":true,"linked":null},"captionStyle":{"show":true,"animation":"fade","fontSize":32,"font":"Inter","bold":true,"italic":false,"underline":false,"uppercase":false,"color":"#FFFFFF","rows":2,"bottom":84.41,"maxWidth":82,"radius":10,"bgOpacity":78,"manualAdd":true},"motion":{"preset":"smooth","connect":true,"classic":false},"audioNormalizeAll":false,"voice":{"denoise":"balanced","level":true},"shortcuts":[],"shortcutStyle":{"show":true,"position":"bottom","size":28,"theme":"dark","labels":"pc"},"shortcutsImported":true}}