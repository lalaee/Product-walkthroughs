{"format":"recordly-project","version":1,"id":"p-rottoways-before-after","name":"Rottoways: before and after","created":"2026-10-03T14:11:20.724Z","edited":"2026-10-03T14:16:11.338Z","duration":41,"folders":[],"recordingIds":["rec-rottoways-before-after"],"bg":"g-3","doc":{"clips":[{"id":"clip-musgzwve-0","recId":"rec-rottoways-before-after","in":0,"out":41.2,"speed":1,"muted":false,"screen":"dashboard","name":"Rottoways: before and after"}],"zooms":[{"id":"zm-musgzxdq-1","start":6.6,"end":9.56,"amount":2,"mode":"manual","focus":{"x":41.77,"y":62.56},"suggested":"6.6|9.56|2|auto|41|62"}],"captions":[{"id":"cap-0","start":1.359,"end":6.755,"text":"This is Rottoways. It stops your website from looking like AI slop."},{"id":"cap-1","start":6.775,"end":11.342,"text":"Here's a landing page the way AI tools build it by default:"},{"id":"cap-2","start":11.362,"end":14.928,"text":"purple gradients, and everything centred."},{"id":"cap-3","start":14.948,"end":19.725,"text":"Switch to After: the same page, with the Rottoways design system."},{"id":"cap-4","start":19.745,"end":24.469,"text":"Your copy stays word for word. Only the design changes."},{"id":"cap-5","start":24.489,"end":29.108,"text":"Use it to renovate a site you've already built, or to start a new one."},{"id":"cap-6","start":29.128,"end":35.591,"text":"The pack has the design system, paste-ready prompts, and video tutorials."},{"id":"cap-7","start":35.611,"end":41.15,"text":"It's nineteen dollars, once, for unlimited projects."}],"annotations":[],"audio":[],"keyframes":[],"aspect":"16:10","scene":{"bgType":"image","bg":"w-grain-8","bgOn":true,"blur":0,"shadow":60,"radius":7,"corners":null,"padding":40,"sides":{"t":68.26666666666667,"l":40,"r":40,"b":40},"crop":{"t":0,"r":0,"b":0,"l":0},"uploads":[],"videoUploads":[]},"cursor":{"show":true,"loop":false,"style":"tahoe","size":2.5,"click":"off","clickColor":"#3B63FB","clickSize":1,"clickOpacity":60,"clickDuration":420,"bounce":1,"bounceSpeed":180,"sway":0.6},"webc